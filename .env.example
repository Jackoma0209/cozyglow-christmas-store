# Stripe API Keys (leave blank locally to run in interactive Demo Checkout Mode)
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional Stripe Price ID overrides (defaults in src/config/product.ts)
STRIPE_PRICE_UPSELL_GBP=
STRIPE_PRICE_UPSELL_USD=

# Public site URL & support contact
NEXT_PUBLIC_SITE_URL=https://cozyglowhome.com
NEXT_PUBLIC_SUPPORT_EMAIL=concierge@cozyglowhome.com

# Transactional order confirmation, newsletter & owner fulfillment emails (Resend)
RESEND_API_KEY=
EMAIL_FROM=CozyGlow™ Orders <orders@cozyglowhome.com>
EMAIL_FROM_HELLO=CozyGlow™ Home Aromatics <hello@cozyglowhome.com>
RESEND_AUDIENCE_ID=
NEWSLETTER_WELCOME_CODE=COZY10
OWNER_FULFILLMENT_EMAIL=

# Optional automated supplier / Zapier / Make / n8n fulfillment webhook
FULFILLMENT_WEBHOOK_URL=
FULFILLMENT_WEBHOOK_SECRET=

# CJdropshipping Automated Fulfillment (Open API v2/v3)
CJ_API_KEY=
CJ_COTTAGE_VID=
CJ_OIL_TRIO_VID=
CJ_OIL_SIX_VID=
CJ_LOGISTIC_NAME=CJPacket Ordinary
CJ_PAY_TYPE=3

# Optional Ad Conversion Pixels (leave blank to disable)
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_TIKTOK_PIXEL_ID=
NEXT_PUBLIC_GA_MEASUREMENT_ID=
